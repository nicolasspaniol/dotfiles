# Ignore everything
*

# Except:

!.gitignore

# Program configs
!.config/
!.config/systemd/
!.config/systemd/**
!.config/helix/
!.config/helix/**
!.config/sway/
!.config/sway/**
!.config/waybar/
!.config/waybar/**
!.config/foot/
!.config/foot/**
!.config/firefox/
!.config/firefox/**
!.config/niri/
!.config/niri/**
!.config/xplr/
!.config/xplr/**
!.config/kak/
!.config/kak/**
!.config/mako/
!.config/mako/**

# Some other configs to track
!ly_config.ini
!.zshrc
!.config/opencode/cli.json

!.local/
!.local/bin/

!tools/
!tools/**

# 'runtime' is a symlink and its contents are not added to git. I'm ignoring it
# so that its contents don't show up on helix file picker
.config/helix/runtime/**
